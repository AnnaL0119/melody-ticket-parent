# ============================================================
# 环境变量模板 —— 复制为 .env 后填入真实值（.env 已被 gitignore）
#   本地开发:  cp .env.example .env  然后加载  (PowerShell:  Get-Content .env | ForEach-Object { Invoke-Expression "export `$env:$_" }  或直接 setx/IDE Run Configuration)
#   Docker:    cp .env.example docker/.env   （docker compose 会自动读取 docker/.env）
# 请勿把真实密钥提交到仓库
# ============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me
# 本地开发时服务连接 MySQL 使用的密码（与 MYSQL_ROOT_PASSWORD 保持一致即可）
MYSQL_PASSWORD=change-me

# ---------- JWT ----------
# 用于签发/校验 token，至少 32 字节（HS256 要求 >=256 位）
# 生成方式: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION=86400000

# ---------- Nacos ----------
NACOS_SERVER_ADDR=localhost:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# ---------- Seata（默认关闭，SEATA_ENABLED=true 时才需要填写） ----------
SEATA_ENABLED=false
SEATA_SECRET_KEY=
# Seata Server 相关（仅 docker-compose 使用）
SEATA_VERSION=1.7.0
SEATA_SERVER_PORT=8091

# ---------- RabbitMQ ----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---------- Sentinel ----------
SENTINEL_DASHBOARD_PORT=8010
# 网关侧秒杀接口 QPS 上限（压测放开限流时调大）
SENTINEL_SECKILL_QPS_LIMIT=50

# ---------- SkyWalking ----------
SW_STORAGE=mysql
SW_JDBC_URL=jdbc:mysql://localhost:3306/sw_skywalking?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&rewriteBatchedStatements=true&allowMultiQueries=true
SW_DATA_SOURCE_USER=root
SW_DATA_SOURCE_PASSWORD=change-me
SW_UI_PORT=8080

# ---------- Gateway ----------
GATEWAY_PORT=8080
