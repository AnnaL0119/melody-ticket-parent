# SkyWalking Java Agent 配置文件
# 将此文件中的配置添加到各服务的 JVM 启动参数中
# 或在 agent/config/agent.config 中修改

# 代理服务名称（每个服务不同）
agent.service_name=${SW_AGENT_NAME:melody-ticket}

# 后端 OAP 服务地址（gRPC）
collector.backend_service=${SW_AGENT_COLLECTOR_BACKEND_SERVICES:localhost:11800}

# 日志采集
agent.logging.reporter.enabled=true
agent.logging.reporter.grpc.heartbeat_period=30

# 采样率：100%
agent.sample_rate=10000

# 忽略特定端点
agent.ignore_suffix=/health

# 插件配置
plugin.mount=true

# 数据库追踪参数
plugin.mysql.trace_sql_parameters=true
plugin.redis.trace_redis_parameters=true

# 日志文件前缀
logging.prefix=skywalking-agent
logging.file_name=agent.log
logging.max_file_size=52428800
logging.max_history_files=3
